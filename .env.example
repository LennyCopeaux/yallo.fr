# ------------------------------------------------------------------
# Yallo — variables d'environnement
# Copier ce fichier en `.env.local` puis renseigner les valeurs.
#   cp .env.example .env.local
# ------------------------------------------------------------------

# --- Base de données (Supabase Postgres) --------------------------
# Utiliser le CONNECTION POOLER en mode SESSION (port 5432).
# Dashboard Supabase > Connect > onglet "Session pooler". Format :
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# ⚠️  NE PAS utiliser le transaction pooler (:6543) avec postgres.js.
# Mesuré sur ce projet : des que le pool doit mettre une requete en file
# d'attente (concurrence > `max`), la connexion deadlock et la page reste
# bloquee jusqu'au statement_timeout (2 min). Le session pooler est stable
# quelle que soit la taille du pool. Voir src/db/index.ts.
#
# ⚠️  RÉGION : la DB doit être dans la même région que le déploiement Vercel.
# Vercel Paris (cdg1) -> Supabase eu-west-3 (Paris).
# Une DB en us-east-1 avec Vercel Paris = +80-150 ms par requête.
#
# NB : le host direct db.<ref>.supabase.co est IPv6-only et échoue sur Vercel (IPv4).
#
# Si le mot de passe contient des caractères spéciaux, les URL-encoder (# -> %23).
DATABASE_URL=

# --- Supabase Auth ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- URLs applicatives --------------------------------------------
# Local app    : http://app.localhost:3000  ← obligatoire (middleware = host "app.*")
# Local market : http://localhost:3000      (site marketing, pas /admin)
# Staging       : https://app.staging.yallo.fr
# Production    : https://app.yallo.fr
NEXT_PUBLIC_APP_URL=http://app.localhost:3000
# Domaine marketing (optionnel) : https://yallo.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) -----------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Yallo <no-reply@yallo.fr>"
RESEND_TO_EMAIL="contact@yallo.fr"

# --- OpenAI (import de menu par photo, Vision) --------------------
OPENAI_API_KEY=

# --- Twilio (téléphonie + SMS de confirmation) --------------------
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
# Optionnel : expéditeur SMS par défaut (E.164). Sinon numéro du restaurant.
TWILIO_SMS_FROM=
# Mettre "false" pour désactiver les SMS de confirmation.
TWILIO_ORDER_CONFIRMATION_SMS=

# --- Vapi (agent vocal — appels réels) ----------------------------
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# --- ElevenLabs (prévisualisation de voix côté dashboard) ---------
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# --- Stripe (abonnements) -----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Sentry (monitoring — prod uniquement) ------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# --- Legacy NextAuth (à conserver tant que non retiré) ------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
