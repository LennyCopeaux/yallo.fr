# ------------------------------------------------------------------
# Yallo — variables d'environnement
# Copier ce fichier en `.env.local` puis renseigner les valeurs.
#   cp .env.example .env.local
# ------------------------------------------------------------------

# --- Base de données (Supabase Postgres) --------------------------
# Utiliser l'URL du CONNECTION POOLER (Dashboard Supabase > Project Settings
# > Database > Connection pooling). Format :
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# NB : le host direct db.<ref>.supabase.co est souvent IPv6-only et échoue
#      sur Vercel (IPv4). Toujours préférer le pooler.
DATABASE_URL=

# --- Supabase Auth ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- URLs applicatives --------------------------------------------
# Local app    : http://app.localhost:3000  ← obligatoire (middleware = host "app.*")
# Local market : http://localhost:3000      (site marketing, pas /admin)
# Staging       : https://app.staging.yallo.fr
# Production    : https://app.yallo.fr
NEXT_PUBLIC_APP_URL=http://app.localhost:3000
# Domaine marketing (optionnel) : https://yallo.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) -----------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="Yallo <no-reply@yallo.fr>"
RESEND_TO_EMAIL="contact@yallo.fr"

# --- OpenAI (import de menu par photo, Vision) --------------------
OPENAI_API_KEY=

# --- Twilio (téléphonie + SMS de confirmation) --------------------
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=
# Optionnel : expéditeur SMS par défaut (E.164). Sinon numéro du restaurant.
TWILIO_SMS_FROM=
# Mettre "false" pour désactiver les SMS de confirmation.
TWILIO_ORDER_CONFIRMATION_SMS=

# --- Vapi (agent vocal — appels réels) ----------------------------
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# --- ElevenLabs (prévisualisation de voix côté dashboard) ---------
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# --- Stripe (abonnements) -----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Sentry (monitoring — prod uniquement) ------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# --- Legacy NextAuth (à conserver tant que non retiré) ------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000
