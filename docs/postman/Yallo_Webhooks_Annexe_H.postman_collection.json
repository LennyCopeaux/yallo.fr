{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-yallo-webhooks01",
    "name": "Yallo — Webhooks Vapi & Stripe (Annexe H)",
    "description": "Collection de recettes techniques pour les webhooks Yallo.\n\nEndpoints couverts :\n- POST /api/vapi/webhook?rid={restaurantId}\n- POST /api/stripe/webhook\n\nVariables à renseigner dans la collection : baseUrl, restaurantId, vapiWebhookSecret.\n\nStripe : la signature réelle se génère avec le Stripe CLI (`stripe listen --forward-to ...`). Les requêtes « signature manquante / invalide » démontrent le contrôle A08 OWASP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://app.localhost:3000",
      "type": "string"
    },
    {
      "key": "restaurantId",
      "value": "REMPLACER_PAR_UUID_RESTAURANT",
      "type": "string"
    },
    {
      "key": "vapiWebhookSecret",
      "value": "REMPLACER_PAR_VAPI_WEBHOOK_SECRET",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Vapi",
      "item": [
        {
          "name": "01 — tool-calls submit_order (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-vapi-secret",
                "value": "{{vapiWebhookSecret}}",
                "description": "Doit correspondre à VAPI_WEBHOOK_SECRET"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": {\n    \"type\": \"tool-calls\",\n    \"call\": {\n      \"id\": \"call_demo_postman_001\",\n      \"customer\": {\n        \"number\": \"+33612345678\"\n      }\n    },\n    \"toolCallList\": [\n      {\n        \"id\": \"toolu_demo_001\",\n        \"name\": \"submit_order\",\n        \"arguments\": {\n          \"customer_name\": \"Jean Dupont\",\n          \"customer_phone\": \"+33612345678\",\n          \"pickup_time\": \"12:30\",\n          \"notes\": \"Sans oignons\",\n          \"items\": [\n            {\n              \"name\": \"Menu Classic\",\n              \"quantity\": 1,\n              \"unit_price\": 12.5,\n              \"options\": [\"Frites\", \"Coca\"]\n            }\n          ]\n        }\n      }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vapi/webhook?rid={{restaurantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vapi", "webhook"],
              "query": [
                {
                  "key": "rid",
                  "value": "{{restaurantId}}",
                  "description": "UUID restaurant (obligatoire)"
                }
              ]
            },
            "description": "Simule un tool-call Vapi `submit_order`. Attendu : HTTP 200 + results[].result JSON avec success."
          },
          "response": []
        },
        {
          "name": "02 — end-of-call-report (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-vapi-secret",
                "value": "{{vapiWebhookSecret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": {\n    \"type\": \"end-of-call-report\",\n    \"durationSeconds\": 95,\n    \"endedReason\": \"customer-ended-call\",\n    \"call\": {\n      \"id\": \"call_demo_postman_001\",\n      \"startedAt\": \"2026-07-19T10:00:00.000Z\",\n      \"endedAt\": \"2026-07-19T10:01:35.000Z\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vapi/webhook?rid={{restaurantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vapi", "webhook"],
              "query": [
                {
                  "key": "rid",
                  "value": "{{restaurantId}}"
                }
              ]
            },
            "description": "Enregistre un call_log (idempotent via onConflictDoNothing). Attendu : HTTP 200."
          },
          "response": []
        },
        {
          "name": "03 — secret incorrect (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-vapi-secret",
                "value": "wrong-secret-for-demo"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": {\n    \"type\": \"end-of-call-report\",\n    \"durationSeconds\": 10,\n    \"call\": { \"id\": \"call_unauthorized\" }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vapi/webhook?rid={{restaurantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vapi", "webhook"],
              "query": [
                {
                  "key": "rid",
                  "value": "{{restaurantId}}"
                }
              ]
            },
            "description": "Recette sécurité RS-07 / RT-04 : secret invalide → HTTP 401 Unauthorized."
          },
          "response": []
        },
        {
          "name": "04 — rid manquant (200 config error)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-vapi-secret",
                "value": "{{vapiWebhookSecret}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": {\n    \"type\": \"tool-calls\",\n    \"toolCallList\": []\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vapi/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vapi", "webhook"]
            },
            "description": "Sans `?rid=` : le webhook renvoie 200 avec un message d'erreur de config (comportement Vapi-friendly)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Stripe",
      "item": [
        {
          "name": "01 — signature manquante (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_demo\",\n  \"object\": \"event\",\n  \"type\": \"customer.subscription.updated\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"sub_demo\",\n      \"object\": \"subscription\",\n      \"status\": \"active\",\n      \"customer\": \"cus_demo\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stripe/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stripe", "webhook"]
            },
            "description": "Sans header `stripe-signature` → HTTP 400 `{ error: \"Missing stripe-signature header\" }`.\nDémontre A08 Integrity Failures (OWASP)."
          },
          "response": []
        },
        {
          "name": "02 — signature invalide (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "stripe-signature",
                "value": "t=1234567890,v1=invalidsignaturefordemo"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_demo_invalid\",\n  \"object\": \"event\",\n  \"type\": \"customer.subscription.updated\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"sub_demo\",\n      \"object\": \"subscription\",\n      \"status\": \"active\",\n      \"customer\": \"cus_demo\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stripe/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stripe", "webhook"]
            },
            "description": "Signature forgée → HTTP 400 `{ error: \"Webhook Error\" }` (constructEvent échoue)."
          },
          "response": []
        },
        {
          "name": "03 — event réel via Stripe CLI (doc)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "stripe-signature",
                "value": "GENERATED_BY_STRIPE_CLI",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"_comment\": \"Ne pas envoyer ce body depuis Postman tel quel.\",\n  \"_howto\": [\n    \"1. brew install stripe/stripe-cli/stripe\",\n    \"2. stripe login\",\n    \"3. stripe listen --forward-to {{baseUrl}}/api/stripe/webhook\",\n    \"4. Copier le whsec_... affiché dans STRIPE_WEBHOOK_SECRET (.env.local)\",\n    \"5. stripe trigger customer.subscription.updated\",\n    \"6. Capturer la réponse 200 { received: true } dans les logs CLI / Vercel\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/stripe/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stripe", "webhook"]
            },
            "description": "Pour un event Stripe **réellement signé**, utiliser le Stripe CLI (voir body `_howto`). Postman ne peut pas forger une signature valide sans le secret."
          },
          "response": []
        }
      ]
    }
  ]
}
